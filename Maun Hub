-- SYSTEM HARD ANTI-ROLLBACK (SAFEGUARD POSITION SYNC)
local function zeroVelocity(hrp)
    if hrp then
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
    end
end

local function hardNoRollbackTP(targetCFrame)
    pcall(function()
        local char = player.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if hrp then
            zeroVelocity(hrp)
            hrp.Anchored = true
            hrp.CFrame = targetCFrame
            task.wait(0.02)
            zeroVelocity(hrp)
            hrp.Anchored = false
            task.wait(0.01)
            zeroVelocity(hrp)
        end
    end)
end

-- TWEEN TP SANGAT HALUS KETIKA AUTO BREAK (PREVENTS ROLLBACK)
local function safeTweenTP(targetCFrame)
    pcall(function()
        local char = player.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if hrp then
            zeroVelocity(hrp)
            local dist = (hrp.Position - targetCFrame.Position).Magnitude
            local dur = dist / 130
            if dur < 0.05 then dur = 0.05 end
            
            local tween = TweenService:Create(hrp, TweenInfo.new(dur, Enum.EasingStyle.Linear), {CFrame = targetCFrame})
            tween:Play()
            tween.Completed:Wait()
            zeroVelocity(hrp)
        end
    end)
end

-- CARI PUSAT KOORDINAT ZONA MENGGUNAKAN UNIK NAMA BIOME/TELUR
local function getZoneCenterPos(zoneData)
    local matchedPositions = {}
    for _, obj in pairs(Workspace:GetDescendants()) do
        if obj:IsA("BasePart") and (obj.Name == "Egg" or obj.Name:find("Egg")) then
            local fullPathName = (obj.Name .. " " .. (obj.Parent and obj.Parent.Name or "")):lower()
            for _, kw in ipairs(zoneData.Keywords) do
                if fullPathName:find(kw) then
                    table.insert(matchedPositions, obj.Position)
                    break
                end
            end
        end
    end

    if #matchedPositions > 0 then
        local sum = Vector3.zero
        for _, pos in ipairs(matchedPositions) do sum = sum + pos end
        return sum / #matchedPositions
    end

    for _, obj in pairs(Workspace:GetDescendants()) do
        local n = obj.Name:lower()
        for _, kw in ipairs(zoneData.Keywords) do
            if n:find(kw) then
                if obj:IsA("Model") then return obj:GetPivot().Position end
                if obj:IsA("BasePart") then return obj.Position end
            end
        end
    end

    return safeZoneCFrame.Position + Vector3.new(0, 0, zoneData.Num * 220)
end

local function tpToZoneByData(zoneData)
    local targetPos = getZoneCenterPos(zoneData)
    if targetPos then
        hardNoRollbackTP(CFrame.new(targetPos + Vector3.new(0, 4, 0)))
    end
end

-- AUTO BREAK LOOP (ANTI ROLLBACK WITH SAFE TWEEN)
local destroyedEggs = {}

task.spawn(function()
    while true do
        if State.AutoBreak then
            pcall(function()
                local char = player.Character
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                local zoneData = MapZones[currentZoneIdx]
                local targetZonePos = getZoneCenterPos(zoneData)

                if hrp and targetZonePos then
                    local closestEgg, minDist = nil, 99999
                    for _, obj in pairs(Workspace:GetDescendants()) do
                        if obj:IsA("BasePart") and (obj.Name == "Egg" or obj.Name:find("Egg")) and obj.Parent and not destroyedEggs[obj] then
                            if (obj.Position - targetZonePos).Magnitude <= 200 then
                                local d = (obj.Position - hrp.Position).Magnitude
                                if d < minDist then minDist, closestEgg = d, obj end
                            end
                        end
                    end

                    if closestEgg and closestEgg.Parent then
                        safeTweenTP(CFrame.new(closestEgg.Position + Vector3.new(0, 2.5, 0)))
                        
                        for i = 1, 8 do
                            if not State.AutoBreak or not closestEgg.Parent then break end
                            if eggRemote then eggRemote:FireServer(closestEgg, i) end
                            task.wait(0.02)
                        end

                        destroyedEggs[closestEgg] = true
                        task.delay(5, function() destroyedEggs[closestEgg] = nil end)
                    end
                end
            end)
            task.wait(0.05)
        else task.wait(0.3) end
    end
end)

-- STRICT ANTI-KANDANG FILTER (AUTO STEAL INSTANT TP HARD ANTI-ROLLBACK)
local function isInPlotOrBase(obj)
    local current = obj
    while current and current ~= Workspace do
        local n = current.Name:lower()
        if n:find("plot") or n:find("kandang") or n:find("base") or n:find("house") or n:find("tycoon") or n:find("myplot") or n:find("claim") or n:find("fence") then
            return true
        end
        current = current.Parent
    end
    return false
end

local blacklistNames = {"egg", "guard", "shop", "zone", "nest", "part", "base", "spawn", "treadmill", "pickaxe", "cage", "wall", "floor", "plot", "safe", "portal", "door", "gate", "handle", "merchant", "trails", "halloween", "gift", "reward", "sign", "board", "button"}

local function triggerStealPrompt(prompt)
    if not prompt or not prompt.Enabled then return false end
    pcall(function()
        if fireproximityprompt then fireproximityprompt(prompt)
        else prompt:InputHoldBegin() task.wait(prompt.HoldDuration > 0 and (prompt.HoldDuration + 0.05) or 0.1) prompt:InputHoldEnd() end
    end)
    return true
end

task.spawn(function()
    local skipped = {}
    while true do
        if State.AutoSteal then
            pcall(function()
                local char = player.Character
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                if hrp then
                    local targetAnimal, minDist = nil, 999999
                    for _, obj in pairs(Workspace:GetDescendants()) do
                        if obj:IsA("Model") and obj ~= char and not Players:GetPlayerFromCharacter(obj) and not skipped[obj] then
                            if not isInPlotOrBase(obj) then
                                local n = obj.Name:lower()
                                local isBlacklisted = false
                                for _, bw in pairs(blacklistNames) do if n:find(bw) then isBlacklisted = true break end end
                                
                                if not isBlacklisted then
                                    local prompt = obj:FindFirstChildWhichIsA("ProximityPrompt", true)
                                    if prompt then
                                        local pPos = prompt.Parent and prompt.Parent.Position or obj:GetPivot().Position
                                        local d = (pPos - hrp.Position).Magnitude
                                        if d < minDist then minDist, targetAnimal = d, obj end
                                    end
                                end
                            end
                        end
                    end

                    if targetAnimal then
                        local prompt = targetAnimal:FindFirstChildWhichIsA("ProximityPrompt", true)
                        if prompt and prompt.Parent then
                            hardNoRollbackTP(CFrame.new(prompt.Parent.Position + Vector3.new(0, 2, 3)))
                            task.wait(0.1)
                            local done = triggerStealPrompt(prompt)
                            task.wait(0.15)
                            hardNoRollbackTP(safeZoneCFrame)
                            task.wait(0.5)
                            if not done then
                                skipped[targetAnimal] = true
                                task.delay(8, function() skipped[targetAnimal] = nil end)
                            end
                        end
                    end
                end
            end)
            task.wait(0.1)
        else task.wait(0.2) end
    end
end)

