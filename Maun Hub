-- TWEEN LOGIC
local activeTween = nil
local function resetPhysics(hrp)
    if hrp then pcall(function() hrp.AssemblyLinearVelocity, hrp.AssemblyAngularVelocity = Vector3.zero, Vector3.zero end) end
end

local function safeTweenTo(targetPos, speed)
    local char = player.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp or (hrp.Position - targetPos).Magnitude < 3 then return end
    if activeTween then pcall(function() activeTween:Cancel() end) end
    resetPhysics(hrp)
    local tweenSpeed = speed or 75
    activeTween = TweenService:Create(hrp, TweenInfo.new((hrp.Position - targetPos).Magnitude / tweenSpeed, Enum.EasingStyle.Linear), { CFrame = CFrame.new(targetPos + Vector3.new(0, 2, 0)) })
    activeTween:Play()
    while activeTween and activeTween.PlaybackState == Enum.PlaybackState.Playing do task.wait(0.04) end
    resetPhysics(hrp)
end

local function ultraFastTweenTo(targetPos)
    local char = player.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp or (hrp.Position - targetPos).Magnitude < 3 then return end
    if activeTween then pcall(function() activeTween:Cancel() end) end
    resetPhysics(hrp)
    activeTween = TweenService:Create(hrp, TweenInfo.new((hrp.Position - targetPos).Magnitude / 150, Enum.EasingStyle.Linear), { CFrame = CFrame.new(targetPos + Vector3.new(0, 2, 0)) })
    activeTween:Play()
    while activeTween and activeTween.PlaybackState == Enum.PlaybackState.Playing do task.wait(0.01) end
    resetPhysics(hrp)
end

local function getZoneObject(zoneNum)
    local searchNames = {"zone" .. zoneNum, "zone " .. zoneNum, "area" .. zoneNum, "area " .. zoneNum, "world" .. zoneNum}
    for _, obj in pairs(Workspace:GetChildren()) do
        local n = obj.Name:lower()
        for _, sName in pairs(searchNames) do if n == sName or n:find(sName) then return obj end end
    end
    for _, obj in pairs(Workspace:GetDescendants()) do
        if obj:IsA("BasePart") or obj:IsA("Model") then
            local n = obj.Name:lower()
            for _, sName in pairs(searchNames) do if n == sName then return obj end end
        end
    end
    return nil
end

local function tpToZone(zoneNum)
    local targetObj = getZoneObject(zoneNum)
    if targetObj then
        local pos = targetObj:IsA("Model") and targetObj:GetPivot().Position or targetObj.Position
        safeTweenTo(pos + Vector3.new(0, 3, 0), 85)
    end
end

-- SERENITY STYLE AUTO BREAK LOOP (FAST HIT)
task.spawn(function()
    while true do
        if State.AutoBreak then
            pcall(function()
                local char = player.Character
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                local zoneObj = getZoneObject(currentZone)
                if hrp then
                    if zoneObj then
                        local zPos = zoneObj:IsA("Model") and zoneObj:GetPivot().Position or zoneObj.Position
                        if (hrp.Position - zPos).Magnitude > 120 then safeTweenTo(zPos + Vector3.new(0, 3, 0), 80) end
                    end
                    local closestEgg, minDist = nil, 9999
                    for _, obj in pairs(Workspace:GetDescendants()) do
                        if obj:IsA("BasePart") and obj.Name == "Egg" and obj.Parent then
                            local isEggInZone = true
                            if zoneObj then
                                local zPos = zoneObj:IsA("Model") and zoneObj:GetPivot().Position or zoneObj.Position
                                if (obj.Position - zPos).Magnitude > 110 then isEggInZone = false end
                            end
                            if isEggInZone then
                                local d = (obj.Position - hrp.Position).Magnitude
                                if d < minDist then minDist, closestEgg = d, obj end
                            end
                        end
                    end
                    if closestEgg and closestEgg.Parent then
                        if minDist > 5 then safeTweenTo(closestEgg.Position, 80) end
                        local hitCount = 0
                        while closestEgg and closestEgg.Parent and State.AutoBreak do
                            hitCount = hitCount + 1
                            if eggRemote then eggRemote:FireServer(closestEgg, hitCount) end
                            task.wait(0.25)
                            if hitCount >= 10 or not closestEgg.Parent or (closestEgg:IsA("BasePart") and closestEgg.Transparency > 0.2) then break end
                        end
                    end
                end
            end)
            task.wait(0.05)
        else task.wait(0.3) end
    end
end)

