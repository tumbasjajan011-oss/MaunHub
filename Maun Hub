local activeTween = nil
local function resetPhysics(hrp)
    if hrp then pcall(function() hrp.AssemblyLinearVelocity, hrp.AssemblyAngularVelocity = Vector3.zero, Vector3.zero end) end
end

local function safeTweenTo(targetPos, speed)
    local char = player.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp or (hrp.Position - targetPos).Magnitude < 3 then return end
    if activeTween then pcall(function() activeTween:Cancel() end) end
    resetPhysics(hrp)
    local tweenSpeed = speed or 70
    activeTween = TweenService:Create(hrp, TweenInfo.new((hrp.Position - targetPos).Magnitude / tweenSpeed, Enum.EasingStyle.Linear), { CFrame = CFrame.new(targetPos + Vector3.new(0, 2, 0)) })
    activeTween:Play()
    while activeTween and activeTween.PlaybackState == Enum.PlaybackState.Playing do task.wait(0.05) end
    resetPhysics(hrp)
end

local function ultraFastTweenTo(targetPos)
    local char = player.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp or (hrp.Position - targetPos).Magnitude < 3 then return end
    if activeTween then pcall(function() activeTween:Cancel() end) end
    resetPhysics(hrp)
    activeTween = TweenService:Create(hrp, TweenInfo.new((hrp.Position - targetPos).Magnitude / 150, Enum.EasingStyle.Linear), { CFrame = CFrame.new(targetPos + Vector3.new(0, 2, 0)) })
    activeTween:Play()
    while activeTween and activeTween.PlaybackState == Enum.PlaybackState.Playing do task.wait(0.01) end
    resetPhysics(hrp)
end

local function getZoneObject(zoneNum)
    local searchNames = {"zone" .. zoneNum, "zone " .. zoneNum, "area" .. zoneNum, "area " .. zoneNum, "world" .. zoneNum}
    for _, obj in pairs(Workspace:GetChildren()) do
        local n = obj.Name:lower()
        for _, sName in pairs(searchNames) do if n == sName or n:find(sName) then return obj end end
    end
    for _, obj in pairs(Workspace:GetDescendants()) do
        if obj:IsA("BasePart") or obj:IsA("Model") then
            local n = obj.Name:lower()
            for _, sName in pairs(searchNames) do if n == sName then return obj end end
        end
    end
    return nil
end

local function tpToZone(zoneNum)
    local targetObj = getZoneObject(zoneNum)
    if targetObj then
        local pos = targetObj:IsA("Model") and targetObj:GetPivot().Position or targetObj.Position
        safeTweenTo(pos + Vector3.new(0, 3, 0), 80)
    end
end

local function parseValueText(txt)
    if not txt then return 0 end
    txt = tostring(txt):upper():gsub("%$", ""):gsub(",", "")
    local num = tonumber(txt:match("[%d%.]+")) or 0
    if txt:find("T") then return num * 1000000000000 end
    if txt:find("B") then return num * 1000000000 end
    if txt:find("M") then return num * 1000000 end
    if txt:find("K") then return num * 1000 end
    return num
end

local function getAnimalValue(obj)
    local maxVal = 0
    pcall(function()
        for _, gui in pairs(obj:GetDescendants()) do
            if gui:IsA("TextLabel") or gui:IsA("TextButton") then
                local val = parseValueText(gui.Text)
                if val > maxVal then maxVal = val end
            end
        end
    end)
    return maxVal
end

