-- INSTANT TP FUNCTION
local function instantTP(targetCFrame)
    pcall(function()
        local char = player.Character
        if char then
            if char:FindFirstChild("HumanoidRootPart") then
                char.HumanoidRootPart.CFrame = targetCFrame
            elseif char:IsA("Model") then
                char:PivotTo(targetCFrame)
            end
        end
    end)
end

local function getZoneObjectByName(zName)
    local rawKeyword = zName:gsub(" Zone", ""):lower()
    for _, obj in pairs(Workspace:GetChildren()) do
        local n = obj.Name:lower()
        if n:find(rawKeyword) then return obj end
    end
    for _, obj in pairs(Workspace:GetDescendants()) do
        if obj:IsA("BasePart") or obj:IsA("Model") then
            local n = obj.Name:lower()
            if n == rawKeyword or n == zName:lower() then return obj end
        end
    end
    return nil
end

local function tpToZone(zName)
    local targetObj = getZoneObjectByName(zName)
    if targetObj then
        local pos = targetObj:IsA("Model") and targetObj:GetPivot().Position or targetObj.Position
        instantTP(CFrame.new(pos + Vector3.new(0, 3, 0)))
    end
end

-- INSTANT TP AUTO BREAK LOOP
task.spawn(function()
    while true do
        if State.AutoBreak then
            pcall(function()
                local char = player.Character
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                local activeZoneName = ZoneNames[currentZoneIndex]
                local zoneObj = getZoneObjectByName(activeZoneName)
                if hrp then
                    local closestEgg, minDist = nil, 9999
                    for _, obj in pairs(Workspace:GetDescendants()) do
                        if obj:IsA("BasePart") and obj.Name == "Egg" and obj.Parent then
                            local isEggInZone = true
                            if zoneObj then
                                local zPos = zoneObj:IsA("Model") and zoneObj:GetPivot().Position or zoneObj.Position
                                if (obj.Position - zPos).Magnitude > 110 then isEggInZone = false end
                            end
                            if isEggInZone then
                                local d = (obj.Position - hrp.Position).Magnitude
                                if d < minDist then minDist, closestEgg = d, obj end
                            end
                        end
                    end
                    if closestEgg and closestEgg.Parent then
                        instantTP(CFrame.new(closestEgg.Position + Vector3.new(0, 3, 0)))
                        local hitCount = 0
                        while closestEgg and closestEgg.Parent and State.AutoBreak do
                            hitCount = hitCount + 1
                            if eggRemote then eggRemote:FireServer(closestEgg, hitCount) end
                            task.wait(0.08)
                            if hitCount >= 10 or not closestEgg.Parent or (closestEgg:IsA("BasePart") and closestEgg.Transparency > 0.2) then break end
                        end
                    end
                end
            end)
            task.wait(0.05)
        else task.wait(0.3) end
    end
end)

-- AUTO STEAL LOGIC (MATCHING SERENITY HUB VIDEO DEMO)
local blacklistNames = {"egg", "guard", "shop", "zone", "nest", "part", "base", "spawn", "treadmill", "pickaxe", "cage", "wall", "floor", "plot", "safe", "portal", "door", "gate", "handle", "merchant", "trails", "halloween", "gift", "reward", "sign", "board", "button"}

local function triggerStealPrompt(prompt)
    if not prompt or not prompt.Enabled then return false end
    pcall(function()
        if fireproximityprompt then fireproximityprompt(prompt)
        else prompt:InputHoldBegin() task.wait(prompt.HoldDuration > 0 and (prompt.HoldDuration + 0.05) or 0.1) prompt:InputHoldEnd() end
    end)
    return true
end

task.spawn(function()
    local skipped = {}
    while true do
        if State.AutoSteal then
            pcall(function()
                local char = player.Character
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                if hrp then
                    local targetAnimal, minDist = nil, 999999
                    for _, obj in pairs(Workspace:GetDescendants()) do
                        if obj:IsA("Model") and obj ~= char and not Players:GetPlayerFromCharacter(obj) and not skipped[obj] then
                            local n = obj.Name:lower()
                            local isBlacklisted = false
                            for _, bw in pairs(blacklistNames) do if n:find(bw) then isBlacklisted = true break end end
                            
                            if not isBlacklisted then
                                local prompt = obj:FindFirstChildWhichIsA("ProximityPrompt", true)
                                if prompt then
                                    local pPos = prompt.Parent and prompt.Parent.Position or obj:GetPivot().Position
                                    local d = (pPos - hrp.Position).Magnitude
                                    if d < minDist then minDist, targetAnimal = d, obj end
                                end
                            end
                        end
                    end

                    if targetAnimal then
                        local prompt = targetAnimal:FindFirstChildWhichIsA("ProximityPrompt", true)
                        if prompt and prompt.Parent then
                            -- 1. Instant TP ke depan hewan yang akan dicuri
                            instantTP(CFrame.new(prompt.Parent.Position + Vector3.new(0, 2, 3)))
                            task.wait(0.1)
                            -- 2. Interaksi pencurian
                            local done = triggerStealPrompt(prompt)
                            task.wait(0.15)
                            -- 3. Teleport balik instan membawa hewan hasil curian ke Safe Zone / Base
                            instantTP(safeZoneCFrame)
                            task.wait(0.5)
                            if not done then
                                skipped[targetAnimal] = true
                                task.delay(8, function() skipped[targetAnimal] = nil end)
                            end
                        end
                    end
                end
            end)
            task.wait(0.1)
        else task.wait(0.2) end
    end
end)

