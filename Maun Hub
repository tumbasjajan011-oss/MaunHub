-- INSTANT TELEPORT
local function instantTP(targetCFrame)
    pcall(function()
        local char = player.Character
        if char then
            if char:FindFirstChild("HumanoidRootPart") then
                char.HumanoidRootPart.CFrame = targetCFrame
            elseif char:IsA("Model") then
                char:PivotTo(targetCFrame)
            end
        end
    end)
end

-- DYNAMIC ZONE SCANNER
local discoveredZones = {}
local currentZoneIdx = 1

local function scanMapZones()
    discoveredZones = {}
    for _, obj in pairs(Workspace:GetDescendants()) do
        if obj:IsA("BasePart") or obj:IsA("Model") then
            local n = obj.Name
            if n:find("Zone") or n:find("Area") or n:find("World") or obj.Name == "Egg" then
                local parentName = obj.Parent and obj.Parent.Name or ""
                if not discoveredZones[parentName] and #parentName > 2 and not parentName:find("Workspace") and not parentName:find("Plot") then
                    table.insert(discoveredZones, {Name = parentName, Position = obj:IsA("Model") and obj:GetPivot().Position or obj.Position})
                end
            end
        end
    end
    if #discoveredZones == 0 then
        table.insert(discoveredZones, {Name = "Spawn Zone", Position = safeZoneCFrame.Position})
    end
end
scanMapZones()

-- SERENITY STYLE AUTO BREAK
task.spawn(function()
    while true do
        if State.AutoBreak then
            pcall(function()
                local char = player.Character
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                if hrp then
                    local closestEgg, minDist = nil, 99999
                    for _, obj in pairs(Workspace:GetDescendants()) do
                        if obj:IsA("BasePart") and (obj.Name == "Egg" or obj.Name:find("Egg")) and obj.Parent then
                            -- Pastikan bukan milik kandang player
                            local pName = obj.Parent.Name:lower()
                            if not pName:find("plot") and not pName:find("base") and not pName:find("kandang") and not pName:find("house") then
                                local d = (obj.Position - hrp.Position).Magnitude
                                if d < minDist then minDist, closestEgg = d, obj end
                            end
                        end
                    end

                    if closestEgg and closestEgg.Parent then
                        -- 1. Teleport Tepat di atas/samping telur
                        instantTP(CFrame.new(closestEgg.Position + Vector3.new(0, 2, 0)))
                        
                        -- 2. Spam hit remote secara instan (Serenity Style)
                        local hitCount = 0
                        while closestEgg and closestEgg.Parent and State.AutoBreak do
                            hitCount = hitCount + 1
                            if eggRemote then eggRemote:FireServer(closestEgg, hitCount) end
                            task.wait(0.05) -- Fast Spam
                            if hitCount >= 12 or not closestEgg.Parent or (closestEgg:IsA("BasePart") and closestEgg.Transparency > 0.2) then break end
                        end
                    end
                end
            end)
            task.wait(0.05)
        else task.wait(0.3) end
    end
end)

-- STRICT ANTI-KANDANG FILTER (AUTO STEAL)
local function isInPlotOrBase(obj)
    local current = obj
    while current and current ~= Workspace do
        local n = current.Name:lower()
        if n:find("plot") or n:find("kandang") or n:find("base") or n:find("house") or n:find("tycoon") or n:find("myplot") or n:find("claim") or n:find("fence") then
            return true
        end
        current = current.Parent
    end
    return false
end

local blacklistNames = {"egg", "guard", "shop", "zone", "nest", "part", "base", "spawn", "treadmill", "pickaxe", "cage", "wall", "floor", "plot", "safe", "portal", "door", "gate", "handle", "merchant", "trails", "halloween", "gift", "reward", "sign", "board", "button"}

