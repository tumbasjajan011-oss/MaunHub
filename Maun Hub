local blacklist = {"egg", "guard", "shop", "zone", "nest", "part", "base", "spawn", "treadmill", "pickaxe", "cage", "wall", "floor", "plot", "safe", "portal", "door", "gate", "handle", "merchant", "trails", "halloween", "gift", "reward", "sign", "board", "button"}

local function isInPlot(obj)
    local current = obj
    while current and current ~= Workspace do
        local n = current.Name:lower()
        if n:find("plot") or n:find("kandang") or n:find("base") or n:find("house") or n:find("tycoon") then return true end
        current = current.Parent
    end
    return false
end

local function isAnimal(obj)
    if not obj or not obj:IsA("Model") or obj == player.Character or Players:GetPlayerFromCharacter(obj) or obj:FindFirstChildOfClass("Humanoid") then return false end
    if isInPlot(obj) then return false end
    local n = obj.Name:lower()
    for _, w in pairs(blacklist) do if n:find(w) then return false end end
    if not (obj:FindFirstChildWhichIsA("MeshPart", true) or obj:FindFirstChildWhichIsA("SpecialMesh", true)) or not obj:FindFirstChildWhichIsA("BillboardGui", true) then return false end
    if State.MinStealValue > 0 and getAnimalValue(obj) < State.MinStealValue then return false end
    return true
end

local function triggerPrompt(prompt)
    if not prompt or not prompt.Enabled then return false end
    pcall(function()
        if fireproximityprompt then fireproximityprompt(prompt)
        else prompt:InputHoldBegin() task.wait(prompt.HoldDuration > 0 and (prompt.HoldDuration + 0.05) or 0.1) prompt:InputHoldEnd() end
    end)
    return true
end

local function interactWithAnimal(animalObj, animalPos)
    local prompt = animalObj:FindFirstChildWhichIsA("ProximityPrompt", true)
    if prompt then return triggerPrompt(prompt) end
    local cd = animalObj:FindFirstChildWhichIsA("ClickDetector", true)
    if cd then pcall(function() if fireclickdetector then fireclickdetector(cd) else cd:Click(player) end end) return true end
    for _, obj in pairs(Workspace:GetDescendants()) do
        if obj:IsA("ProximityPrompt") and obj.Parent and obj.Parent:IsA("BasePart") then
            if (obj.Parent.Position - animalPos).Magnitude <= 15 then return triggerPrompt(obj) end
        end
    end
    return false
end

task.spawn(function()
    local skipped = {}
    while true do
        if State.AutoSteal then
            pcall(function()
                local char = player.Character
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                if hrp then
                    local closestAnimal, minDist = nil, 999999
                    for _, obj in pairs(Workspace:GetDescendants()) do
                        if isAnimal(obj) and not skipped[obj] then
                            local ok, pivot = pcall(function() return obj:GetPivot().Position end)
                            if ok and pivot then
                                local d = (pivot - hrp.Position).Magnitude
                                if d < minDist then minDist, closestAnimal = d, obj end
                            end
                        end
                    end
                    if closestAnimal then
                        local animalPos = closestAnimal:GetPivot().Position
                        ultraFastTweenTo(animalPos)
                        task.wait(0.1)
                        local success = interactWithAnimal(closestAnimal, animalPos)
                        ultraFastTweenTo(safeZoneCFrame.Position)
                        task.wait(0.5)
                        if not success then
                            skipped[closestAnimal] = true
                            task.delay(8, function() skipped[closestAnimal] = nil end)
                        end
                    end
                end
            end)
            task.wait(0.1)
        else task.wait(0.2) end
    end
end)

local function fireUpgradeRemote(keywords)
    pcall(function()
        for _, obj in pairs(ReplicatedStorage:GetDescendants()) do
            if obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction") then
                local n = obj.Name:lower()
                for _, kw in pairs(keywords) do if n:find(kw) and obj:IsA("RemoteEvent") then obj:FireServer() end end
            end
        end
    end)
end

